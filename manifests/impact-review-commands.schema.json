{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Local impact task update commands; project envelope remains required for non-default projects",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "action": {
          "const": "prepare_impact_updates"
        },
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "impact_run": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "updates": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "task": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "task_version": {
                "type": "integer",
                "minimum": 1
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8192
              }
            },
            "required": [
              "task",
              "task_version",
              "description"
            ]
          }
        }
      },
      "required": [
        "action",
        "key",
        "impact_run",
        "updates"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "action": {
          "const": "select_impact_changes"
        },
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "selection_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "selected": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      },
      "required": [
        "action",
        "key",
        "selection_id",
        "selected"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "action": {
          "const": "approve_impact_changes"
        },
        "selection_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "action",
        "selection_id"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "action": {
          "const": "apply_impact_changes"
        },
        "selection_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "approval": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "action",
        "selection_id",
        "approval"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "action": {
          "const": "decide_impact_changes"
        },
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "action_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "decision": {
          "type": "string",
          "enum": [
            "reject",
            "defer"
          ]
        }
      },
      "required": [
        "action",
        "key",
        "action_id",
        "decision"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "key",
        "impact_run",
        "tasks",
        "state",
        "reason"
      ],
      "properties": {
        "action": {
          "const": "prepare_task_lifecycle"
        },
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "impact_run": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "tasks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "task": {
                "type": "string",
                "minLength": 1
              },
              "task_version": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "task",
              "task_version"
            ]
          }
        },
        "state": {
          "enum": [
            "cancelled",
            "todo"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      }
    }
  ]
}
