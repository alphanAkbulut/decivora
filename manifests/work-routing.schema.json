{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "work-routing",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task",
    "task_version",
    "base_revision",
    "work_class",
    "executor",
    "human_suitable",
    "reason",
    "key",
    "revision",
    "request_digest",
    "recorded_at",
    "format"
  ],
  "properties": {
    "task": {
      "type": "string",
      "maxLength": 1024
    },
    "task_version": {
      "type": "integer",
      "minimum": 1
    },
    "base_revision": {
      "type": "integer",
      "minimum": 0
    },
    "work_class": {
      "enum": [
        "DETERMINISTIC",
        "LOW_COMPLEXITY",
        "REASONING",
        "HUMAN_DECISION"
      ]
    },
    "executor": {
      "enum": [
        "SYSTEM",
        "SCRIPT",
        "API",
        "AGENT",
        "HUMAN"
      ]
    },
    "human_suitable": {
      "type": "boolean"
    },
    "reason": {
      "type": "string",
      "maxLength": 1024
    },
    "key": {
      "type": "string",
      "maxLength": 1024
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "request_digest": {
      "type": "string",
      "maxLength": 1024
    },
    "recorded_at": {
      "type": "number"
    },
    "format": {
      "const": "decivora-routing-1"
    }
  }
}
