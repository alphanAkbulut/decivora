{
  "protocol_version": "2025-06-18",
  "transport": "stdio",
  "tools": [
    {
      "name": "get_project_brief",
      "description": "Bounded current records, not exhaustive context.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "project_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "budget": {
            "type": "integer",
            "minimum": 1024,
            "maximum": 4096
          }
        },
        "required": [
          "project_id"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "query_records",
      "description": "Scoped current record previews with revision-bound cursor.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "project_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 25
          },
          "filters": {
            "type": "object",
            "properties": {
              "type": {
                "enum": [
                  "Artifact",
                  "Decision",
                  "DocumentInstruction",
                  "Finding",
                  "Idea",
                  "PendingDecision",
                  "Prompt",
                  "Requirement",
                  "Risk",
                  "Task"
                ]
              }
            },
            "required": [],
            "additionalProperties": false
          },
          "cursor": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "project_id"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "get_record",
      "description": "Get an exact current record version; no raw SQL.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "project_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "project_id",
          "id",
          "revision"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "submit_changeset",
      "description": "Persist a create-only draft proposal; human approval and application are separate.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "project_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "base_revision": {
            "type": "integer",
            "minimum": 0
          },
          "operations": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "items": {
              "type": "object",
              "properties": {
                "op": {
                  "enum": [
                    "create"
                  ]
                },
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "body": {
                  "type": "object"
                }
              },
              "required": [
                "op",
                "id",
                "body"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "project_id",
          "key",
          "base_revision",
          "operations"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "submit_evidence",
      "description": "Record an untrusted agent execution claim, never verified criterion evidence.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "project_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "task": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "task_version": {
            "type": "integer",
            "minimum": 1
          },
          "status": {
            "enum": [
              "claimed",
              "failed",
              "unknown"
            ]
          },
          "reference": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "note": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "required": [
          "project_id",
          "key",
          "task",
          "task_version",
          "status",
          "reference",
          "note"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "openWorldHint": false
      }
    }
  ]
}
