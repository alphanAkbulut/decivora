{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "expression": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ref",
            "revision"
          ],
          "properties": {
            "ref": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
            },
            "revision": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "all"
          ],
          "properties": {
            "all": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "items": {
                "$ref": "#/$defs/expression"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "any"
          ],
          "properties": {
            "any": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "items": {
                "$ref": "#/$defs/expression"
              }
            }
          }
        }
      ]
    }
  },
  "$comment": "Runtime additionally enforces depth 8, 64 unique references, complete current required_by coverage, revisions and human authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "action",
    "task",
    "task_version",
    "base_revision",
    "expression",
    "facts",
    "reviewed_complete",
    "reason",
    "key"
  ],
  "properties": {
    "action": {
      "const": "save_task_rationale"
    },
    "task": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "task_version": {
      "type": "integer",
      "minimum": 1
    },
    "base_revision": {
      "type": "integer",
      "minimum": 0
    },
    "expression": {
      "$ref": "#/$defs/expression"
    },
    "facts": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 64,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "revision",
          "valid"
        ],
        "properties": {
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "valid": {
            "type": [
              "boolean",
              "null"
            ]
          }
        }
      }
    },
    "reviewed_complete": {
      "const": true
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "key": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    }
  }
}
