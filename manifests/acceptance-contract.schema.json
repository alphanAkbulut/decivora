{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "op",
    "task",
    "task_version",
    "base_contract",
    "criteria",
    "dod",
    "reason",
    "acknowledged_changes"
  ],
  "properties": {
    "op": {
      "const": "acceptance_contract"
    },
    "task": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "task_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "base_contract": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "statement",
          "method",
          "required",
          "applicable",
          "applicability_reason"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "statement": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "method": {
            "enum": [
              "automatic_test",
              "file_check",
              "human_review"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "applicable": {
            "type": "boolean"
          },
          "applicability_reason": {
            "type": "string",
            "maxLength": 512
          }
        }
      }
    },
    "dod": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "statement",
          "method",
          "required",
          "applicable",
          "applicability_reason"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "statement": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "method": {
            "enum": [
              "automatic_test",
              "file_check",
              "human_review"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "applicable": {
            "type": "boolean"
          },
          "applicability_reason": {
            "type": "string",
            "maxLength": 512
          }
        }
      }
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "acknowledged_changes": {
      "type": "array",
      "maxItems": 48,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
      }
    }
  },
  "$comment": "Custom runtime also validates whitespace, cross-array unique IDs, applicability reasons, current Task/contract revision and explicit diff acknowledgment."
}
