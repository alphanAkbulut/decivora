{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Authenticated local Operations projection, not security audit or full pipeline tracing",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "available": {
      "type": "boolean"
    },
    "lost_this_process": {
      "type": "integer",
      "minimum": 0
    },
    "persistent": {
      "const": true
    },
    "runs": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "component": {
            "type": "string"
          },
          "started": {
            "type": "number"
          },
          "finished": {
            "type": [
              "number",
              "null"
            ]
          },
          "duration_ms": {
            "type": [
              "number",
              "null"
            ]
          },
          "outcome": {
            "enum": [
              "started",
              "succeeded",
              "failed",
              "unknown"
            ]
          },
          "code": {
            "type": [
              "string",
              "null"
            ]
          },
          "action": {
            "type": "string"
          },
          "stages": {
            "type": "array",
            "maxItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "position": {
                  "type": "integer",
                  "minimum": 1
                },
                "component": {
                  "type": "string"
                },
                "stage": {
                  "enum": [
                    "authorize_project",
                    "execute_command"
                  ]
                },
                "started": {
                  "type": "number"
                },
                "finished": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "duration_ms": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "outcome": {
                  "enum": [
                    "started",
                    "succeeded",
                    "failed",
                    "unknown"
                  ]
                },
                "code": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "position",
                "component",
                "stage",
                "started",
                "finished",
                "duration_ms",
                "outcome",
                "code"
              ]
            }
          },
          "identity": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "properties": {
              "workspace": {
                "type": "string"
              },
              "actor_id": {
                "type": "string"
              },
              "actor_type": {
                "enum": [
                  "human",
                  "agent"
                ]
              },
              "authz_revision": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "workspace",
              "actor_id",
              "actor_type",
              "authz_revision"
            ]
          }
        },
        "required": [
          "id",
          "component",
          "started",
          "finished",
          "duration_ms",
          "outcome",
          "code",
          "action",
          "stages",
          "identity"
        ]
      }
    },
    "errors": {
      "type": "array",
      "maxItems": 25,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "endpoint": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "first_seen": {
            "type": "number"
          },
          "last_seen": {
            "type": "number"
          },
          "count": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "id",
          "endpoint",
          "code",
          "first_seen",
          "last_seen",
          "count"
        ]
      }
    },
    "evicted": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "limits": {
      "type": "object"
    },
    "coverage": {
      "enum": [
        "local_command_boundaries_only",
        "unavailable"
      ]
    },
    "environment": {
      "enum": [
        "local",
        "test"
      ]
    },
    "project": {
      "type": "string"
    },
    "uptime_seconds": {
      "type": "number"
    },
    "application_processes": {
      "const": 1
    },
    "background_worker_active": {
      "const": false
    },
    "queue": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "model_configured": {
      "type": "boolean"
    },
    "file_checker_configured": {
      "type": "boolean"
    },
    "native_capture": {
      "const": false,
      "description": "Application-managed native background worker is disabled; explicit native CLI passes can still appear in runs."
    },
    "external_mcp_host": {
      "const": "not_verified"
    },
    "conversation_queue": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "counts": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "applied_sources": {
          "type": "integer",
          "minimum": 0
        },
        "items": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "source_id": {
                "type": "string"
              },
              "source_kind": {
                "enum": [
                  "manual_paste",
                  "codex_exec_jsonl",
                  "codex_app_server"
                ]
              },
              "status": {
                "enum": [
                  "Waiting for model",
                  "Ready for review",
                  "Analysis failed",
                  "Analysis unknown"
                ]
              },
              "received_at": {
                "type": "number"
              },
              "durable_outbox": {
                "type": "boolean"
              },
              "applied": {
                "type": "boolean"
              }
            },
            "required": [
              "source_id",
              "source_kind",
              "status",
              "received_at",
              "durable_outbox",
              "applied"
            ]
          }
        },
        "background_worker_active": {
          "const": false
        },
        "automatic_dispatch": {
          "const": false
        },
        "capacity": {
          "const": 32
        },
        "scope": {
          "const": "selected_project"
        },
        "coverage": {
          "const": "saved_sources_only"
        }
      },
      "required": [
        "total",
        "counts",
        "applied_sources",
        "items",
        "background_worker_active",
        "automatic_dispatch",
        "capacity",
        "scope",
        "coverage"
      ]
    }
  },
  "required": [
    "available",
    "lost_this_process",
    "persistent",
    "runs",
    "errors",
    "evicted",
    "coverage",
    "environment",
    "project",
    "uptime_seconds",
    "application_processes",
    "background_worker_active",
    "queue",
    "model_configured",
    "file_checker_configured",
    "native_capture",
    "external_mcp_host",
    "conversation_queue"
  ]
}
